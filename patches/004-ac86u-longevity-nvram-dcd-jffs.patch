diff --git a/release/src/router/rc/watchdog.c b/release/src/router/rc/watchdog.c
--- a/release/src/router/rc/watchdog.c
+++ b/release/src/router/rc/watchdog.c
@@ -159,7 +159,7 @@
 
 //#if defined(RTCONFIG_JFFS2LOG) && defined(RTCONFIG_JFFS2)
 #if defined(RTCONFIG_JFFS2LOG) && (defined(RTCONFIG_JFFS2)||defined(RTCONFIG_BRCM_NAND_JFFS2))
-#define LOG_COMMIT_PERIOD	2		/* 2 x 30 seconds */
+#define LOG_COMMIT_PERIOD	60		/* 60 x 30 seconds = 30 minutes default */
 static int log_commit_count = 0;
 #endif
 #if defined(RTCONFIG_USB_MODEM)
@@ -7552,27 +7552,34 @@
 #if defined(RTCONFIG_JFFS2LOG) && (defined(RTCONFIG_JFFS2)||defined(RTCONFIG_BRCM_NAND_JFFS2))
 void syslog_commit_check(void)
 {
-	struct stat tmp_log_stat, jffs_log_stat;
+	struct stat tmp_log_stat, jffs_log_stat, tmp_rot_stat, jffs_rot_stat;
 	int tmp_stat, jffs_stat;
-	char prefix[PATH_MAX], path1[PATH_MAX];
+	char prefix[PATH_MAX], path1[PATH_MAX], path2[PATH_MAX];
+	int period = nvram_get("jffs2_log_period") ? nvram_get_int("jffs2_log_period") : LOG_COMMIT_PERIOD;
+
+	if (period <= 0)
+		return; /* 0 = keep syslog in /tmp RAM; stop_syslogd() still syncs on clean reboot */
 
 	snprintf(prefix, sizeof(prefix), "%s", nvram_safe_get("log_path"));
 	snprintf(path1, sizeof(path1), "%s/syslog.log", prefix);
+	snprintf(path2, sizeof(path2), "%s/syslog.log-1", prefix);
 
 	tmp_stat = stat("/tmp/syslog.log", &tmp_log_stat);
 	if (tmp_stat == -1)
 		return;
 
-	if (++log_commit_count >= LOG_COMMIT_PERIOD) {
+	if (++log_commit_count >= period) {
 		jffs_stat = stat(path1, &jffs_log_stat);
-		if ( jffs_stat == -1) {
-			eval("cp", "/tmp/syslog.log", "/tmp/syslog.log-1", prefix);
-			return;
-		}
-
-		if ( tmp_log_stat.st_size > jffs_log_stat.st_size ||
-		     difftime(tmp_log_stat.st_mtime, jffs_log_stat.st_mtime) > 0)
-			eval("cp", "/tmp/syslog.log", "/tmp/syslog.log-1", prefix);
+		if (jffs_stat == -1 ||
+		    tmp_log_stat.st_size != jffs_log_stat.st_size ||
+		    difftime(tmp_log_stat.st_mtime, jffs_log_stat.st_mtime) > 0)
+			eval("cp", "-f", "/tmp/syslog.log", path1);
+
+		if (stat("/tmp/syslog.log-1", &tmp_rot_stat) == 0 &&
+		    (stat(path2, &jffs_rot_stat) == -1 ||
+		     tmp_rot_stat.st_size != jffs_rot_stat.st_size ||
+		     difftime(tmp_rot_stat.st_mtime, jffs_rot_stat.st_mtime) > 0))
+			eval("cp", "-f", "/tmp/syslog.log-1", path2);
 
 		log_commit_count = 0;
 	}
