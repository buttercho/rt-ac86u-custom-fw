+	f_write_string("/proc/sys/net/core/netdev_max_backlog", "4096", 0, 0);
+	f_write_string("/proc/sys/net/core/somaxconn", "512", 0, 0);
 
 #ifdef GTAC2900
 	update_cfe_ac2900();
@@ -5219,6 +5284,7 @@ void init_others(void)
 		system("pwr config --wait off");
