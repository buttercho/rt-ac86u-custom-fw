@@ -5197,6 +5206,58 @@ void tweak_process_affinity(pid_t pid, unsigned int cpumask)
 	sched_setaffinity(pid, sizeof(cpu_set_t), &cpuset);
 }
 
+#if defined(RTAC86U) || defined(GTAC2900)
+static void bcm4906_tune_smp_and_rps(void)
+{
+	pid_t pid;
+	FILE *fp;
+	char line[256];
+	int wl_idx = 0;
+
+	if (nvram_get_int("cpu_affinity_disable"))
+		return;
+
+	/* Pin switch RX vs SKB free across dual Cortex-A53 cores without touching Runner/Flow Cache */
+	if ((pid = get_pid_by_thrd_name((char *)"bcmsw_rx")) > 0)
+		tweak_process_affinity(pid, 1);
+	if ((pid = get_pid_by_thrd_name((char *)"skb_free_task")) > 0)
+		tweak_process_affinity(pid, 2);
+
+	if ((fp = fopen("/proc/interrupts", "r")) != NULL) {
+		while (fgets(line, sizeof(line), fp) != NULL) {
+			char *p = line, *endp = NULL;
+			unsigned long irq;
+			char irq_path[64];
+			const char *mask;
+
+			while (*p == ' ' || *p == '\t')
+				p++;
+			irq = strtoul(p, &endp, 10);
+			if (endp == p || *endp != ':')
+				continue;
+
+			if (!(strstr(line, "dhd") || strstr(line, "wl0") || strstr(line, "wl1") || strstr(line, "wl2")))
+				continue;
+
+			snprintf(irq_path, sizeof(irq_path), "/proc/irq/%lu/smp_affinity", irq);
+			mask = (wl_idx & 1) ? "2" : "1";
+			f_write_string(irq_path, mask, 0, 0);
+			wl_idx++;
+		}
+		fclose(fp);
+	}
+
+	/* Configure software fallback RPS/RFS across both CPUs (Runner/Flow Cache stays 100% active) */
+	f_write_string("/proc/sys/net/core/rps_sock_flow_entries", "32768", 0, 0);
+	set_iface_ps("br0", 3);
+	set_iface_ps("eth0", 3);
+	if (access("/sys/class/net/br0/queues/rx-0/rps_flow_cnt", W_OK) == 0)
+		f_write_string("/sys/class/net/br0/queues/rx-0/rps_flow_cnt", "4096", 0, 0);
+	if (access("/sys/class/net/eth0/queues/rx-0/rps_flow_cnt", W_OK) == 0)
+		f_write_string("/sys/class/net/eth0/queues/rx-0/rps_flow_cnt", "4096", 0, 0);
+}
+#endif
